<?xml version="1.0" encoding="utf-8"?>
<framework>
    <if device="tablet" device_size="large" keyboard_mode="normal">
        <if four_or_more_letter_rows="true">
            <view layout="@layout/APKTOOL_DUMMYVAL_0x7f0e04e4" type="body" />
        </if>
        <else_if enable_number_row="true">
            <view layout="@layout/APKTOOL_DUMMYVAL_0x7f0e04e4" type="body" />
        </else_if>
        <else>
            <view layout="@layout/APKTOOL_DUMMYVAL_0x7f0e04ed" type="body" />
        </else>
    </if>
    <else_if keyboard_mode="split">
        <if split_with_duplicate_keys="true">
            <view layout="@layout/APKTOOL_DUMMYVAL_0x7f0e04e7" type="body" />
        </if>
        <else>
            <view layout="@layout/APKTOOL_DUMMYVAL_0x7f0e04e8" type="body" />
        </else>
    </else_if>
    <else>
        <view layout="@layout/APKTOOL_DUMMYVAL_0x7f0e04e6" type="body" />
    </else>
</framework>
