<?xml version="1.0" encoding="utf-8"?>
<framework>
    <processors>
        <if enable_input_unicode="true">
            <processor class="com.google.android.libraries.inputmethod.ime.processor.ComposingTextProcessor" />
        </if>
        <if enable_voice_in_chinese="true">
            <processor class="com.google.android.apps.inputmethod.libs.hmmvoice.ChineseHmmVoiceInputProcessor" />
        </if>
        <processor class="com.google.android.apps.inputmethod.libs.pinyin.HmmPinyinQwertyDecodeProcessor" />
        <processor class="com.google.android.apps.inputmethod.libs.chinese.ime.hmm.ChineseDoubleSpaceProcessor" />
        <processor class="com.google.android.apps.inputmethod.libs.chinese.ime.hmm.ChineseAutoSpaceProcessor" />
        <processor class="com.google.android.libraries.inputmethod.ime.processor.ScrubMoveProcessor" />
        <processor class="com.google.android.libraries.inputmethod.ime.processor.OutputProcessor" />
    </processors>
</framework>
