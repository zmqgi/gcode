}

key SEMICOLON {
    label:                              '\u0a1a'
    base:                               '\u0a1a'
    shift:                              '\u0a1b'
}

key APOSTROPHE {
    label:                              '\u0a1f'
    base:                               '\u0a1f'
    shift:                              '\u0a20'
}

### ROW 4

key X {
    label:                              '\u0a70'
    base:                               '\u0a70'
    shift:                              '\u0a02'
    ralt+shift:                         '\u0a74'
}

key C {
    label:                              '\u0a2e'
    base:                               '\u0a2e'
    shift:                              '\u0a23'
}

key V {
    label:                              '\u0a28'
    base:                               '\u0a28'
}

key B {
    label:                              '\u0a35'
    base:                               '\u0a35'
    shift:                              '\u0a72'
    ralt:                               '\u0a73'
}

key N {
    label:                              '\u0a32'
    base:                               '\u0a32'
    shift:                              '\u0a33'
}

key M {
