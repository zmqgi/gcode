# Punjabi keyboard layout.

type OVERLAY

### ROW 1

key GRAVE {
    shift:                              '~'
}

key 1 {
    label:                              '1'
    base:                               '1'
    shift:                              '!'
    ralt:                               '\u0a67'
    ctrl+shift:                         '\u200d'
}

key 2 {
    label:                              '2'
    base:                               '2'
    shift:                              '@'
    ralt:                               '\u0a68'
    ctrl+shift:                         '\u200c'
}

key 3 {
    label:                              '3'
    base:                               '3'
    shift:                              '#'
    ralt:                               '\u0a69'
}

key 4 {
    label:                              '4'
    base:                               '4'
    shift:                              '\u0a71'
    ralt:                               '\u0a6a'
    ctrl+shift:                         '\u20b9'
}

key 5 {
    label:                              '5'
    base:                               '5'
    ralt:                               '\u0a6b'
}

key 6 {
    label:                              '6'
    base:                               '6'
    ralt:                               '\u0a6c'
}

key 7 {
    label:                              '7'
    base:                               '7'
    ralt:                               '\u0a6d'
}

key 8 {
    label:                              '8'
    base:                               '8'
    ralt:                               '\u0a6e'
}

key 9 {
    label:                              '9'
    base:                               '9'
    shift:                              '('
    ralt:                               '\u0a6f'
}

key 0 {
    label:                              '0'
    base:                               '0'
    shift:                              ')'
    ralt:                               '\u0a66'
}

key MINUS {
    label:                              '-'
    base:                               '-'
}

### ROW 2

key Q {
    label:                              '\u0a4c'
    base:                               '\u0a4c'
    shift:                              '\u0a14'
}

key W {
    label:                              '\u0a48'
    base:                               '\u0a48'
    shift:                              '\u0a10'
}

key E {
    label:                              '\u0a3e'
    base:                               '\u0a3e'
    shift:                              '\u0a06'
}

key R {
    label:                              '\u0a40'
    base:                               '\u0a40'
    shift:                              '\u0a08'
}

key T {
    label:                              '\u0a42'
    base:                               '\u0a42'
    shift:                              '\u0a0a'
}

key Y {
    label:                              '\u0a2c'
    base:                               '\u0a2c'
    shift:                              '\u0a2d'
}

key U {
    label:                              '\u0a39'
    base:                               '\u0a39'
    shift:                              '\u0a19'
}

key I {
    label:                              '\u0a17'
    base:                               '\u0a17'
    shift:                              '\u0a18'
    ralt:                               '\u0a5a'
}

key O {
    label:                              '\u0a26'
    base:                               '\u0a26'
    shift:                              '\u0a27'
}

key P {
    label:                              '\u0a1c'
    base:                               '\u0a1c'
    shift:                              '\u0a1d'
    ralt:                               '\u0a5b'
}

key LEFT_BRACKET {
    label:                              '\u0a21'
    base:                               '\u0a21'
    shift:                              '\u0a22'
    ralt:                               '\u0a5c'
}

key RIGHT_BRACKET {
    label:                              '\u0a3c'
    base:                               '\u0a3c'
    shift:                              '\u0a1e'
}

### ROW 3

key A {
    label:                              '\u0a4b'
    base:                               '\u0a4b'
    shift:                              '\u0a13'
}

key S {
    label:                              '\u0a47'
    base:                               '\u0a47'
