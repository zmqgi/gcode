# Bulgarian (Phonetic Traditional) keyboard layout.

type OVERLAY

map key 86 PLUS

### ROW 1

key GRAVE {
    label:                              '\u0427'
    base:                               '\u0447'
    shift, capslock:                    '\u0427'
    capslock+shift:                     '\u0447'
}

key 1 {
    label:                              '1'
    base:                               '1'
    shift:                              '!'
}

key 2 {
    label:                              '2'
    base:                               '2'
    shift:                              '@'
}

key 3 {
    label:                              '3'
    base:                               '3'
    shift:                              '\u2116'
}

key 4 {
    label:                              '4'
    base:                               '4'
    shift:                              '$'
}

key 5 {
    label:                              '5'
    base:                               '5'
    shift:                              '%'
}

key 6 {
    label:                              '6'
    base:                               '6'
    shift:                              '\u20ac'
}

key 7 {
    label:                              '7'
    base:                               '7'
    shift:                              '\u00a7'
}

key 8 {
    label:                              '8'
    base:                               '8'
    shift:                              '*'
}

key 9 {
    label:                              '9'
    base:                               '9'
    shift:                              '('
}

key 0 {
    label:                              '0'
    base:                               '0'
    shift:                              ')'
}

key MINUS {
    label:                              '-'
    base:                               '-'
    shift:                              '_'
}

key EQUALS {
    label:                              '='
    base:                               '='
    shift:                              '+'
}

### ROW 2

key Q {
    label:                              '\u042f'
    base:                               '\u044f'
    shift, capslock:                    '\u042f'
    capslock+shift:                     '\u044f'
}

key W {
    label:                              '\u0412'
    base:                               '\u0432'
    shift, capslock:                    '\u0412'
    capslock+shift:                     '\u0432'
}

key E {
    label:                              '\u0415'
    base:                               '\u0435'
    shift, capslock:                    '\u0415'
    capslock+shift:                     '\u0435'
}

key R {
    label:                              '\u0420'
    base:                               '\u0440'
    shift, capslock:                    '\u0420'
    capslock+shift:                     '\u0440'
}

key T {
    label:                              '\u0422'
    base:                               '\u0442'
    shift, capslock:                    '\u0422'
    capslock+shift:                     '\u0442'
}

key Y {
    label:                              '\u042a'
    base:                               '\u044a'
    shift, capslock:                    '\u042a'
    capslock+shift:                     '\u044a'
}

key U {
    label:                              '\u0423'
    base:                               '\u0443'
    shift, capslock:                    '\u0423'
    capslock+shift:                     '\u0443'
}

key I {
    label:                              '\u0418'
    base:                               '\u0438'
    shift, capslock:                    '\u0418'
    capslock+shift:                     '\u0438'
}

key O {
    label:                              '\u041e'
    base:                               '\u043e'
    shift, capslock:                    '\u041e'
    capslock+shift:                     '\u043e'
}

key P {
    label:                              '\u041f'
    base:                               '\u043f'
    shift, capslock:                    '\u041f'
    capslock+shift:                     '\u043f'
}

key LEFT_BRACKET {
    label:                              '\u0428'
    base:                               '\u0448'
    shift, capslock:                    '\u0428'
    capslock+shift:                     '\u0448'
    ralt+shift:                         '\u042b'
}

key RIGHT_BRACKET {
    label:                              '\u0429'
    base:                               '\u0449'
    shift, capslock:                    '\u0429'
    capslock+shift:                     '\u0449'
    ralt+shift:                         '\u042d'
}

### ROW 3

key A {
    label:                              '\u0410'
    base:                               '\u0430'
    shift, capslock:                    '\u0410'
    capslock+shift:                     '\u0430'
}

key S {
    label:                              '\u0421'
    base:                               '\u0441'
    shift, capslock:                    '\u0421'
    capslock+shift:                     '\u0441'
}

key D {
    label:                              '\u0414'
    base:                               '\u0434'
    shift, capslock:                    '\u0414'
    capslock+shift:                     '\u0434'
}

key F {
    label:                              '\u0424'
    base:                               '\u0444'
    shift, capslock:                    '\u0424'
    capslock+shift:                     '\u0444'
}

key G {
    label:                              '\u0413'
    base:                               '\u0433'
    shift, capslock:                    '\u0413'
    capslock+shift:                     '\u0433'
}

key H {
    label:                              '\u0425'
    base:                               '\u0445'
    shift, capslock:                    '\u0425'
    capslock+shift:                     '\u0445'
}

key J {
    label:                              '\u0419'
    base:                               '\u0439'
    shift, capslock:                    '\u0419'
    capslock+shift:                     '\u0439'
}

key K {
    label:                              '\u041a'
    base:                               '\u043a'
    shift, capslock:                    '\u041a'
    capslock+shift:                     '\u043a'
}

key L {
    label:                              '\u041b'
    base:                               '\u043b'
    shift, capslock:                    '\u041b'
    capslock+shift:                     '\u043b'
}

key SEMICOLON {
    label:                              ';'
    base:                               ';'
    shift:                              ':'
}

key APOSTROPHE {
    label:                              '\''
    base:                               '\''
    shift:                              '\u0022'
}

key BACKSLASH {
    label:                              '\u042e'
    base:                               '\u044e'
    shift, capslock:                    '\u042e'
    capslock+shift:                     '\u044e'
}

### ROW 4

key PLUS {
    label:                              '\u042e'
    base:                               '\u044e'
    shift, capslock:                    '\u042e'
    capslock+shift:                     '\u044e'
}

key Z {
    label:                              '\u0417'
    base:                               '\u0437'
    shift, capslock:                    '\u0417'
    capslock+shift:                     '\u0437'
}

key X {
    label:                              '\u042c'
    base:                               '\u044c'
    shift:                              '\u045d'
    capslock:                           '\u042c'
    capslock+shift:                     '\u040d'
}

key C {
    label:                              '\u0426'
    base:                               '\u0446'
    shift, capslock:                    '\u0426'
    capslock+shift:                     '\u0446'
}

key V {
    label:                              '\u0416'
    base:                               '\u0436'
    shift, capslock:                    '\u0416'
    capslock+shift:                     '\u0436'
}

key B {
    label:                              '\u0411'
    base:                               '\u0431'
    shift, capslock:                    '\u0411'
    capslock+shift:                     '\u0431'
}

key N {
    label:                              '\u041d'
    base:                               '\u043d'
    shift, capslock:                    '\u041d'
    capslock+shift:                     '\u043d'
}

key M {
    label:                              '\u041c'
    base:                               '\u043c'
    shift, capslock:                    '\u041c'
    capslock+shift:                     '\u043c'
}

key COMMA {
    label:                              ','
    base:                               ','
    shift:                              '<'
}

key PERIOD {
    label:                              '.'
    base:                               '.'
    shift:                              '>'
}

key SLASH {
    label:                              '/'
    base:                               '/'
    shift:                              '?'
}