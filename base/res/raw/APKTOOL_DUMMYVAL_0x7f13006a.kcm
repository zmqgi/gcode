# Kazakh keyboard layout.

type OVERLAY

map key 86 PLUS

### ROW 1

key GRAVE {
    label:                              '('
    base:                               '('
    shift:                              ')'
}

key 1 {
    label:                              '\u0022'
    base:                               '\u0022'
    shift:                              '!'
}

key 2 {
    label:                              '\u04d8'
    base:                               '\u04d9'
    shift, capslock:                    '\u04d8'
    capslock+shift:                     '\u04d9'
}

key 3 {
    label:                              '\u0406'
    base:                               '\u0456'
    shift, capslock:                    '\u0406'
    capslock+shift:                     '\u0456'
}

key 4 {
    label:                              '\u04a2'
    base:                               '\u04a3'
    shift, capslock:                    '\u04a2'
    capslock+shift:                     '\u04a3'
}

key 5 {
    label:                              '\u0492'
    base:                               '\u0493'
    shift, capslock:                    '\u0492'
    capslock+shift:                     '\u0493'
}

key 6 {
    label:                              ','
    base:                               ','
    shift:                              ';'
}

key 7 {
    label:                              '.'
    base:                               '.'
    shift:                              ':'
}

key 8 {
    label:                              '\u04ae'
    base:                               '\u04af'
    shift, capslock:                    '\u04ae'
    capslock+shift:                     '\u04af'
}

key 9 {
    label:                              '\u04b0'
    base:                               '\u04b1'
    shift, capslock:                    '\u04b0'
    capslock+shift:                     '\u04b1'
}

key 0 {
    label:                              '\u049a'
    base:                               '\u049b'
    shift, capslock:                    '\u049a'
    capslock+shift:                     '\u049b'
}

key MINUS {
    label:                              '\u04e8'
    base:                               '\u04e9'
    shift, capslock:                    '\u04e8'
    capslock+shift:                     '\u04e9'
}

key EQUALS {
    label:                              '\u04ba'
    base:                               '\u04bb'
    shift, capslock:                    '\u04ba'
    capslock+shift:                     '\u04bb'
}

### ROW 2

key Q {
    label:                              '\u0419'
    base:                               '\u0439'
    shift, capslock:                    '\u0419'
    capslock+shift:                     '\u0439'
}

key W {
    label:                              '\u0426'
    base:                               '\u0446'
    shift, capslock:                    '\u0426'
    capslock+shift:                     '\u0446'
}

key E {
    label:                              '\u0423'
    base:                               '\u0443'
    shift, capslock:                    '\u0423'
    capslock+shift:                     '\u0443'
}

key R {
    label:                              '\u041a'
    base:                               '\u043a'
    shift, capslock:                    '\u041a'
    capslock+shift:                     '\u043a'
}

key T {
    label:                              '\u0415'
    base:                               '\u0435'
    shift, capslock:                    '\u0415'
    capslock+shift:                     '\u0435'
}

key Y {
    label:                              '\u041d'
    base:                               '\u043d'
    shift, capslock:                    '\u041d'
    capslock+shift:                     '\u043d'
}

key U {
    label:                              '\u0413'
    base:                               '\u0433'
    shift, capslock:                    '\u0413'
    capslock+shift:                     '\u0433'
}

key I {
    label:                              '\u0428'
    base:                               '\u0448'
    shift, capslock:                    '\u0428'
    capslock+shift:                     '\u0448'
}

key O {
    label:                              '\u0429'
    base:                               '\u0449'
    shift, capslock:                    '\u0429'
    capslock+shift:                     '\u0449'
}

key P {
    label:                              '\u0417'
    base:                               '\u0437'
    shift, capslock:                    '\u0417'
    capslock+shift:                     '\u0437'
}

key LEFT_BRACKET {
    label:                              '\u0425'
    base:                               '\u0445'
    shift, capslock:                    '\u0425'
    capslock+shift:                     '\u0445'
}

key RIGHT_BRACKET {
    label:                              '\u042a'
    base:                               '\u044a'
    shift, capslock:                    '\u042a'
    capslock+shift:                     '\u044a'
}

### ROW 3

key A {
    label:                              '\u0424'
    base:                               '\u0444'
    shift, capslock:                    '\u0424'
    capslock+shift:                     '\u0444'
}

key S {
    label:                              '\u042b'
    base:                               '\u044b'
    shift, capslock:                    '\u042b'
    capslock+shift:                     '\u044b'
}

key D {
    label:                              '\u0412'
    base:                               '\u0432'
    shift, capslock:                    '\u0412'
    capslock+shift:                     '\u0432'
}

key F {
    label:                              '\u0410'
    base:                               '\u0430'
    shift, capslock:                    '\u0410'
    capslock+shift:                     '\u0430'
}

key G {
    label:                              '\u041f'
    base:                               '\u043f'
    shift, capslock:                    '\u041f'
    capslock+shift:                     '\u043f'
}

key H {
    label:                              '\u0420'
    base:                               '\u0440'
    shift, capslock:                    '\u0420'
    capslock+shift:                     '\u0440'
}

key J {
    label:                              '\u041e'
    base:                               '\u043e'
    shift, capslock:                    '\u041e'
    capslock+shift:                     '\u043e'
}

key K {
    label:                              '\u041b'
    base:                               '\u043b'
    shift, capslock:                    '\u041b'
    capslock+shift:                     '\u043b'
}

key L {
    label:                              '\u0414'
    base:                               '\u0434'
    shift, capslock:                    '\u0414'
    capslock+shift:                     '\u0434'
}

key SEMICOLON {
    label:                              '\u0416'
    base:                               '\u0436'
    shift, capslock:                    '\u0416'
    capslock+shift:                     '\u0436'
}

key APOSTROPHE {
    label:                              '\u042d'
    base:                               '\u044d'
    shift, capslock:                    '\u042d'
    capslock+shift:                     '\u044d'
}

key BACKSLASH {
    label:                              '\\'
    base:                               '\\'
    shift:                              '/'
}

### ROW 4

key PLUS {
    label:                              '\\'
    base:                               '\\'
    shift, capslock:                    '|'
    capslock+shift:                     '\\'
}

key Z {
    label:                              '\u042f'
    base:                               '\u044f'
    shift, capslock:                    '\u042f'
    capslock+shift:                     '\u044f'
}

key X {
    label:                              '\u0427'
    base:                               '\u0447'
    shift, capslock:                    '\u0427'
    capslock+shift:                     '\u0447'
}

key C {
    label:                              '\u0421'
    base:                               '\u0441'
    shift, capslock:                    '\u0421'
    capslock+shift:                     '\u0441'
}

key V {
    label:                              '\u041c'
    base:                               '\u043c'
    shift, capslock:                    '\u041c'
    capslock+shift:                     '\u043c'
}

key B {
    label:                              '\u0418'
    base:                               '\u0438'
    shift, capslock:                    '\u0418'
    capslock+shift:                     '\u0438'
}

key N {
    label:                              '\u0422'
    base:                               '\u0442'
    shift, capslock:                    '\u0422'
    capslock+shift:                     '\u0442'
}

key M {
    label:                              '\u042c'
    base:                               '\u044c'
    shift, capslock:                    '\u042c'
    capslock+shift:                     '\u044c'
}

key COMMA {
    label:                              '\u0411'
    base:                               '\u0431'
    shift, capslock:                    '\u0411'
    capslock+shift:                     '\u0431'
}

key PERIOD {
    label:                              '\u042e'
    base:                               '\u044e'
    shift, capslock:                    '\u042e'
    capslock+shift:                     '\u044e'
}

key SLASH {
    label:                              '\u2116'
    base:                               '\u2116'
    shift:                              '?'
}